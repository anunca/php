PHP_VERSION=8.5.10
PHP_IMAGE=php:${PHP_VERSION}-fpm-alpine
COMPOSER_VERSION=2.10.2
COMPOSER_IMAGE=composer:${COMPOSER_VERSION}
NGINX_VERSION=1.31.4
NGINX_IMAGE=nginx:${NGINX_VERSION}-alpine-slim

DOMAIN_NAME=app.internal
REGISTRY=registry.${DOMAIN_NAME}/docker-compose

COMPOSER_REQUIRE_PHP_IMAGE=${REGISTRY}/php
COMPOSER_REQUIRE_NGINX_IMAGE=${REGISTRY}/nginx
