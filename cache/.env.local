HAPROXY_VERSION=3.4.3
HAPROXY_IMAGE=haproxy:${HAPROXY_VERSION}-alpine
PHP_VERSION=8.5.10
PHP_IMAGE=php:${PHP_VERSION}-apache
COMPOSER_VERSION=2.10.2
COMPOSER_IMAGE=composer:${COMPOSER_VERSION}
REDIS_VERSION=8.6.2
REDIS_IMAGE=redis:${REDIS_VERSION}-alpine
REDIS_STACK_VERSION=7.4.0-v8
REDIS_STACK_IMAGE=redis/redis-stack:${REDIS_STACK_VERSION}
MEMCACHED_VERSION=1.6.41
MEMCACHED_IMAGE=memcached:${MEMCACHED_VERSION}-alpine

DOMAIN_NAME=app.internal
REGISTRY=registry.${DOMAIN_NAME}
COMPOSE_PROJECT_NAME=cache
APP_IMAGE=${REGISTRY}/${COMPOSE_PROJECT_NAME}:${TAG}

CACHE_ADAPTER=redis
# CACHE_ADAPTER=memcached
# CACHE_ADAPTER=opcache
# CACHE_ADAPTER=filesystem
CACHE_TTL=3600

REDIS_HOST=redis
REDIS_PORT=6379

MEMCACHED_HOST=memcached
MEMCACHED_PORT=11211
MEMCACHED_PREFIX_KEY=prefix_key