PHP_VERSION=8.5.10
PHP_IMAGE=php:${PHP_VERSION}-fpm-alpine
PHP_REDIS_VERSION=6.3.0
NGINX_VERSION=1.31.4
NGINX_IMAGE=nginx:${NGINX_VERSION}-alpine

DOMAIN_NAME=app.internal
REGISTRY=registry.${DOMAIN_NAME}
COMPOSE_PROJECT_NAME=beta
APP_IMAGE=${REGISTRY}/${COMPOSE_PROJECT_NAME}-app:${TAG}
WEB_IMAGE=${REGISTRY}/${COMPOSE_PROJECT_NAME}-web:${TAG}
