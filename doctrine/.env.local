NGINX_VERSION=1.31.4
NGINX_IMAGE=nginx:${NGINX_VERSION}-alpine
PHP_VERSION=8.5.10
PHP_IMAGE=php:${PHP_VERSION}-fpm-alpine
COMPOSER_VERSION=2.10.2
COMPOSER_IMAGE=composer:${COMPOSER_VERSION}
MYSQL_VERSION=8.0.46
# MYSQL_VERSION=8.4.11
# MYSQL_VERSION=9.7.2
# MYSQL_VERSION=26.7.0
MYSQL_IMAGE=mysql:${MYSQL_VERSION}
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=database

DOMAIN_NAME=app.internal
REGISTRY=registry.${DOMAIN_NAME}
COMPOSE_PROJECT_NAME=doctrine
APP_IMAGE=${REGISTRY}/${COMPOSE_PROJECT_NAME}:${TAG}
