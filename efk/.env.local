PHP_VERSION=8.5.10
PHP_IMAGE=php:${PHP_VERSION}-apache
FLUENTD_VERSION=v1.19.3-1.0
FLUENTD_IMAGE=fluentd:${FLUENTD_VERSION}
VERSION=9.3.3
ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:${VERSION}
KIBANA_IMAGE=docker.elastic.co/kibana/kibana:${VERSION}

DOMAIN_NAME=app.internal
REGISTRY=registry.${DOMAIN_NAME}
