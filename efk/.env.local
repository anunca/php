APP_IMAGE=${REGISTRY}/${COMPOSE_PROJECT_NAME}-app:${TAG}
APP_IMAGE_FLUENTD=${REGISTRY}/${COMPOSE_PROJECT_NAME}-fluentd:${TAG}
