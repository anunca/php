PHP_VERSION=8.5.10
PHP_IMAGE=php:${PHP_VERSION}-apache
FLUENTD_VERSION=fluentd:v1.19.3-1.0
VERSION=9.3.3
ES_VERSION=docker.elastic.co/elasticsearch/elasticsearch:${VERSION}
KIBANA_VERSION=docker.elastic.co/kibana/kibana:${VERSION}

DOMAIN_NAME=app.internal
REGISTRY=registry.${DOMAIN_NAME}
COMPOSE_PROJECT_NAME=efk
IMAGE=${REGISTRY}/${COMPOSE_PROJECT_NAME}:${TAG}
IMAGE_FLUENTD=${REGISTRY}/${COMPOSE_PROJECT_NAME}-fluentd:${TAG}
