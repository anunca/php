{
    "name": "demo/builder",
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "test/"
        }
    },
    "require": {
        "php": ">=8.5",
        "php-di/php-di": "7.1.1",
        "symfony/var-dumper": "8.1.7"
    },
    "require-dev": {
        "phpunit/phpunit": "13.3.6"
    },
    "scripts": {
        "lint": "find src/ test/ -type f -name '*.php' -exec php -l {} \\;",
        "test": "./vendor/bin/phpunit",
        "autoload": "composer dump-autoload",
        "check": [
            "@lint",
            "@autoload"
        ]
    }
}
