HTTPD_VERSION=2.4.68
HTTPD_IMAGE=httpd:${HTTPD_VERSION}-alpine
PHP_VERSION=8.5.10
PHP_IMAGE=php:${PHP_VERSION}-fpm-alpine
MEMCACHED_VERSION=1.6.29
MEMCACHED_IMAGE=memcached:${MEMCACHED_VERSION}-alpine
REDIS_VERSION=7.4.0
REDIS_IMAGE=redis:${REDIS_VERSION}-alpine
DRAGONFLY_VERSION=latest
DRAGONFLY_IMAGE=docker.dragonflydb.io/dragonflydb/dragonfly:${DRAGONFLY_VERSION}
