REDIS_HOST=redis
# REDIS_HOST=dragonfly
# REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_DATABASE=db0

DOMAIN_NAME=app.internal
REGISTRY=registry.${DOMAIN_NAME}
COMPOSE_PROJECT_NAME=session
APP_IMAGE=${REGISTRY}/${COMPOSE_PROJECT_NAME}:${TAG}
