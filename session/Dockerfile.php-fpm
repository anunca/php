ARG PHP_IMAGE=php:8.5.10-fpm-alpine

FROM $PHP_IMAGE AS base

#php memcached
# hadolint ignore=DL4006
RUN apk add --no-cache libmemcached\
  && apk add --no-cache --virtual .build-deps autoconf g++ make zlib-dev libmemcached-dev\
  && yes '' | pecl install --force memcached\
  && docker-php-ext-enable memcached\
  && apk del .build-deps

#php redis
# hadolint ignore=DL4006
RUN apk add --no-cache --virtual .build-deps autoconf g++ make\
  && yes '' | pecl install --force redis\
  && docker-php-ext-enable redis\
  && apk del .build-deps

USER www-data:www-data

WORKDIR /tmp/session
RUN chmod 777 /tmp/session\
  && chown www-data:www-data /tmp/session

WORKDIR /run/php
RUN touch /run/php/php-fpm.sock

WORKDIR /app
